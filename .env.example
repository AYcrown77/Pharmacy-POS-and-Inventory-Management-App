# Mustan Healthcare Pharmacy — frontend environment
#
# Copy this to `.env.local` before starting the app:  cp .env.example .env.local
#
# Do not skip it. Without `.env.local` the mocks flag is unset, which defaults
# to ON — the app then runs happily against an in-memory fake and shows you
# invented stock and sales rather than the real database. It looks like it is
# working, which is what makes it worth being explicit about.

# Data source. Leave unset (or "true") to run against the in-memory mock store.
# Set to "false" to talk to the Express API in ../mutaan-backend.
NEXT_PUBLIC_USE_MOCKS=false

# Where the browser sends API calls. Same-origin by default, which is what the
# rewrite below serves — keeps session cookies working with no CORS.
# NEXT_PUBLIC_API_URL=/api

# Server-side only. The Express API's address on the pharmacy server; Next
# forwards /api/* to it as /api/v1/* (see next.config.ts). Required whenever
# NEXT_PUBLIC_USE_MOCKS is false.
API_PROXY_ORIGIN=http://127.0.0.1:5000
